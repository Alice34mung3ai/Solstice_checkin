DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solstice

REDIS_URL=redis://localhost:6379/0

# Queue - use mock for development
QUEUE_TYPE=mock

# Application
APP_NAME=Solstice Check-in Service
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-this

# Vendor API (mock)
VENDOR_API_URL=http://localhost:8080/api/v1/print
VENDOR_API_KEY=test-key

# Timeouts
VENDOR_CONNECTION_TIMEOUT=5.0
VENDOR_READ_TIMEOUT=25.0
VENDOR_TOTAL_TIMEOUT=30.0
VENDOR_MAX_RETRIES=3
VENDOR_RETRY_BACKOFF_BASE=1.0

# Redis
REDIS_LOCK_TTL=30
REDIS_STATE_TTL=600

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=60

# Kiosk
KIOSK_REQUEST_TIMEOUT=35
KIOSK_POLLING_INTERVAL=2

# Logging
LOG_LEVEL=INFO

# Webhook
BASE_URL=http://localhost:8000
WEBHOOK_PATH=/webhook/print-callback